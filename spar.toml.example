# Copy to spar.toml in a project, or ~/.config/spar/config.toml

max_agents = 4
default_backend = "auto" # auto | headless | tmux (native-cli spawn mode)
isolation = "worktree"   # none | worktree | worktree+db | worktree+bwrap
# autonomy: manual | semi | high | full  (recommended: semi or high)
autonomy = "semi"
message_budget = "normal" # none | lean | normal | chatty
auto_cleanup = false
# Delete a run's own target/ and node_modules when its orchestrator finishes. Keeps the
# worktree, its branch and every commit -- this is not cleanup, and it needs no evidence
# because a build regenerates everything it takes.
auto_reclaim = true
# Hide finished runs (done / plan_rejected only) from listings once they have been idle
# this long. Fires at launch, never from `status`. Deletes nothing -- `spar archive --undo`
# or any resume brings a run back. "off" / "0" disables.
auto_archive_after = "14d"

[worktree]
# Reap at-rest runs whose branches are already contained in their own base ref, just
# before a launch cuts new worktrees. On by default: unlike auto_cleanup, this only
# deletes work git says is already in the base branch. Squash merges are not ancestors
# and are never reaped this way.
auto_cleanup_merged = true

[providers]
# Mix CLI + API: "cli:claude", "cli:grok", "api:openai", "api:xai", ...
order = ["cli:claude", "cli:grok", "cli:agy"]

[gates]
plan = true
winner = true
ship = true

[ship]
auto_confirm = false

[timeouts]
# SOFT since O50: where spar starts asking a slot to land its work, not where it is killed.
# Measured over 1869 real dispatches; 38.7% of implementer dispatches run past 30 minutes.
slot_secs = 5400
# review_secs = 5400   # optional; defaults to slot_secs (diff-focused, no full suites)
# The only wall clock that still kills, as a multiple of whichever soft budget the role
# draws. A backstop against a hung process, not a second budget: a slot killed here loses
# everything it has not written down. 1.0 restores the pre-O50 kill-at-the-budget behaviour.
hard_ceiling_multiple = 3.0
# How often a slot past its soft wall clock is asked whether it is still making progress.
nudge_every_secs = 600
stall_warn_secs = 300  # running + no log output for this long ⇒ stalled in status/TUI (0 = off)
wait = "8h"

# Per-role SOFT budget on one dispatch's billed tokens. Tokens never kill a slot: of the 21
# dispatches over 100M billed tokens in the corpus, 18 exited 0, so the expensive tail is
# expensive work and a cap would throw away finished implementations. Crossing a budget
# tells the slot to write its artifact now and say what it did not reach; it is repeated
# every `nudge_fraction` of the budget past it. Numbers are each role's measured p90 across
# 1794 dispatches. 0 silences one role without disabling the rest.
[budget]
enabled = true
nudge_fraction = 0.2
planner = 8000000
plan_critic = 6000000
test_author = 20000000
implementer = 60000000
reviewer = 12000000
tester = 6000000
other = 12000000     # ranker / peer / reconciler: no measured distribution of their own

# Provider assignment by role. Values are @model-capable provider refs (cli:name / api:name).
# `reviewer` is a list (the review fleet). Distinct from [model_select.role_profiles] below,
# which picks a benchmark *profile* per role, not a provider.
# Precedence: explicit --providers (positional) > [roles] > [providers].order. A populated
# [roles] block satisfies the "--providers or --select is required" rule on its own, so
# `spar plan`/`implement` can run with no --providers at all.
[roles]
# planner = "cli:claude"
# plan_critic = "cli:grok"
# implementer = "cli:codex@anthropic/claude-opus-4.5"
# reviewer = ["cli:grok", "cli:agy", "cli:claude"]
# tester = "cli:agy"          # cheap suite runner (was [suite].provider)
# test_author = "cli:grok"    # pre-coding test author (was [spec].provider)

# Full test suite channel (cheap/dumb model). Implementers/reviewers must not run multi-hour suites.
[suite]
enabled = true
timeout_secs = 7200

# Reviewer verdict / acceptance gate. Review timeouts live under [timeouts].
[review]
# An `unverified` acceptance criterion blocks the ship like a `fail`. A criterion the
# reviewer never mentioned always blocks, regardless of this setting.
require_all_criteria = true

# Round-loop economy. A round is a COLD re-dispatch: truncated log, empty context, the
# slot re-derives the repo before doing new work. Measured over 197 runs, one fix round is
# a 6.6x median run cost. `max` is the highest round a run may reach before it parks at the
# awaiting_round_extension human gate (exit 2) instead of buying another; raise a specific
# run's with `spar implement --run <id> --max-rounds <N>` (>= 1). Only 0 HERE disables the
# ceiling -- the flag refuses it, so turning the bound off is a project decision.
# `carry_forward_chars` caps the brief the previous round hands the next one.
[rounds]
max = 8
carry_forward_chars = 4000

# Pre-coding acceptance tests (plan flow). Separate agent freezes tests before implement.
[spec]
enabled = true
# The test_author's SOFT wall clock (it does not draw [timeouts] slot_secs), so the
# hard_ceiling_multiple above applies to this number. Sized just over its measured p90 of
# 45.8m; at the old 1800 the ceiling landed exactly on the observed max with no headroom.
timeout_secs = 3600

# Dynamic model select from vals.ai (opt-in via --select). See `spar model list|pick|refresh`.
[model_select]
# source = "vals"
# Multiple benches → metrics averaged for shared model ids (primary = first).
# benches = ["swebench", "terminal-bench-2-1"]
# cache_ttl_secs = 86400
# allow = ["cli:*", "api:openai", "api:xai"]
# [model_select.profiles.value]
# quality = 0.6
# cost = 0.8
# speed = 0.3
# min_accuracy = 70
# [model_select.role_profiles]   # role → benchmark profile (NOT provider; see [roles] above)
# planner = "best"
# plan_critic = "best"
# implementer = "value"
# reviewer = "value"
# tester = "fast"
# test_author = "fast"
